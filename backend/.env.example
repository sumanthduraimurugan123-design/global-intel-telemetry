# Server Configuration
PORT=5000

# Supabase Credentials (from your Supabase Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional External News API Keys (system automatically falls back to live authenticated RSS & GDELT endpoints if empty)
GNEWS_API_KEY=
NEWS_API_KEY=

# Twilio Telephony Credentials (for real SMS & automated voice call alerts)
# Sign up at https://www.twilio.com/ to get Account SID, Auth Token, and a Twilio phone number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
